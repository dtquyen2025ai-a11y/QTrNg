{
  "name": "tam-an-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tâm An Online – game web 3D chùa trực tuyến",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev:server": "node --env-file-if-exists=.env --watch server/src/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/src/index.ts",
    "migrate": "node --env-file-if-exists=.env server/src/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-concurrency=1 server/test/*.test.ts",
    "e2e": "node scripts/e2e.mjs",
    "backup": "bash scripts/backup.sh"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "three": "^0.187.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
